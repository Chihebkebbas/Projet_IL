# ----- Backend -----
# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/togetherplay

# YouTube Data API v3 key (required, used server-side only)
YT_API_KEY=

# Origin allowed by CORS / Socket.IO (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# HTTP port for the backend (default: 3001)
PORT=3001

# ----- Frontend (Vite) -----
# Public URL of the backend, used by the React app
VITE_API_URL=http://localhost:3001
